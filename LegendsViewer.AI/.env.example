# Provider: auto | openai | anthropic
# auto picks anthropic when the key starts with sk-ant- or the base URL hosts anthropic.com
LLM_PROVIDER=auto

# OpenAI-compatible API (OpenAI cloud or Ollama). For Anthropic, BASE_URL is ignored.
# GPT / o-series on api.openai.com automatically use /v1/responses (needed for tools + reasoning).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic example:
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=sk-ant-...
# OPENAI_MODEL=claude-opus-5

# Local Ollama (AI container uses network_mode: host on Linux):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b
# (Ollama stays on /v1/chat/completions — Responses API is cloud GPT only.)
#
# Docker Compose loads this file via env_file for the `ai` service.
# LV_API_BASE_URL is overridden in compose to http://127.0.0.1:15421.

AI_HOST=0.0.0.0
AI_PORT=15423

# Agent log verbosity: 0 = full tool args/results and replies (no truncation)
# AI_LOG_MAX_CHARS=2000
